# Database Configuration
DB_USER=locabazaar
DB_PASSWORD=replace_with_a_long_random_alphanumeric_password
DB_NAME=locabazaar
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Security Settings
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CONF_URL=https://accounts.google.com/.well-known/openid-configuration


RABBITMQ_USER=locabazaar_worker
RABBITMQ_PASS=replace_with_a_long_random_alphanumeric_password
RABBITMQ_URL=amqp://locabazaar_worker:replace_with_a_long_random_alphanumeric_password@rabbitmq:5672/
# Frontend Configuration
FRONTEND_URL=https://your-vercel-domain.vercel.app
CORS_ORIGINS=https://your-vercel-domain.vercel.app
PUBLIC_DOMAIN=api.your-domain.example

# SMTP (needed for verification and email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=LocaBazaar

